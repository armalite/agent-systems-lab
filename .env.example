# Copy to `.env` and fill in only what a specific, approved experiment needs.
# `.env` is gitignored. Credentials must never appear in traces, results, or logs.
#
# No Milestone 0 code reads these variables. Nothing in this repository makes a paid
# provider call yet, and when provider execution is introduced it must require an explicit
# per-run opt-in: having credentials configured must never be sufficient to start a paid run.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Only set this to target a proxy or gateway instead of the default provider
# endpoint. Note that a value may already be exported in your shell profile.
# ANTHROPIC_BASE_URL=
